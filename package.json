{
  "name": "nodoteca",
  "private": true,
  "version": "0.1.0",
  "description": "A link library where one link can live in many collections.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:db": "node supabase/tests/schema.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push --linked",
    "db:types": "supabase gen types typescript --local > packages/core/src/database.types.ts"
  },
  "devDependencies": {
    "supabase": "^2.0.0",
    "typescript": "^5.6.0",
    "@electric-sql/pglite": "^0.3.0"
  }
}
