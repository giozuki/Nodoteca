{
  "name": "nodoteca",
  "private": true,
  "version": "0.1.0",
  "description": "A link library where one link can live in many collections.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @nodoteca/web",
    "build": "npm run build -w @nodoteca/web",
    "build:extension": "npm run build -w @nodoteca/extension",
    "test": "npm run test:core && npm run test:db",
    "test:core": "node --test \"packages/core/src/**/*.test.ts\"",
    "test:db": "node supabase/tests/schema.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push --linked",
    "db:types": "supabase gen types typescript --local > packages/core/src/database.types.ts",
    "functions:deploy": "supabase functions deploy link-preview --use-api"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^24.19.2",
    "supabase": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
