# Copy this file to `.env` and fill in the values from
# Supabase dashboard -> Project Settings -> API Keys.
#
# The publishable key (sb_publishable_...) is PUBLIC by design: it ships inside
# the web app and the extension. Data is protected by Row Level Security,
# not by hiding this key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Sign-in code: set to true once custom SMTP is configured and the
# "Magic Link" email template includes {{ .Token }}.
VITE_AUTH_CODE=false

# NEVER put the secret key (sb_secret_... / service_role) in this repo or in any client code.
